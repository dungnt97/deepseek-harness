<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE. `install.sh` substitutes __HOME__ and __PORT__ and writes the result to
  ~/Library/LaunchAgents/ai.dsh.update-feed.plist

  Serves ~/.dsh/update-feed (nightly-mac.yml plus the application zip that update.sh
  publishes) on 127.0.0.1 only. The application's app-update.yml points here, so its
  Check for Updates menu, download progress, and Install and Restart use this feed.

  Manage:  launchctl kickstart -k gui/$(id -u)/ai.dsh.update-feed
  Log:     ~/.dsh/update-feed.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.dsh.update-feed</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>http.server</string>
    <string>__PORT__</string>
    <string>--bind</string>
    <string>127.0.0.1</string>
    <string>--directory</string>
    <string>__HOME__/.dsh/update-feed</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.dsh/update-feed.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.dsh/update-feed.log</string>
</dict>
</plist>
