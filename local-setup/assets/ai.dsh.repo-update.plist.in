<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.dsh.repo-update</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/local-setup/check-update.sh</string>
	</array>
	<!-- Hourly: a build is ready in the app's Check for Updates within about an hour of an
	     upstream commit; a run with nothing new is only a fetch. -->
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
