<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.dsh.gui-path</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.dsh/bin/set-gui-path.sh</string>
	</array>
	<!-- Runs once per login to republish PATH after launchd resets it. -->
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
